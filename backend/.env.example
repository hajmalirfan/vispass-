# Database Configuration - PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vispass

# JWT Secret Key (change this in production!)
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mailtrap (forgot-password OTP emails) - works for Visitor, Host, Checker
MAILTRAP_API_TOKEN=<YOUR_MAILTRAP_API_TOKEN>
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME=VisPass Support
OTP_EXPIRE_MINUTES=10
